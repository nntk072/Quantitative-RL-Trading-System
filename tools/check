#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
GATE="${1:-fast}"
PYTHON_BIN="${QRL_PYTHON:-}"
if [[ -z "$PYTHON_BIN" ]]; then
  case "$(uname -m)" in
    aarch64|arm64)
      if [[ -x "$ROOT/.venv/bin/python" ]]; then
        PYTHON_BIN="$ROOT/.venv/bin/python"
      fi
      ;;
    x86_64)
      if [[ -x "$ROOT/.venv-x86/bin/python" ]]; then
        PYTHON_BIN="$ROOT/.venv-x86/bin/python"
      fi
      ;;
  esac
fi
UV_BIN="${QRL_UV:-}"
if [[ -z "$UV_BIN" && -n "$PYTHON_BIN" ]]; then
  PROJECT_UV="$(dirname "$PYTHON_BIN")/uv"
  if [[ -x "$PROJECT_UV" ]]; then
    UV_BIN="$PROJECT_UV"
  fi
fi
UV_BIN="${UV_BIN:-uv}"

run_module() {
  if [[ -n "$PYTHON_BIN" ]]; then
    "$PYTHON_BIN" -m "$@"
  else
    "$UV_BIN" run -- python -m "$@"
  fi
}

sync_dev() {
  if [[ -z "$PYTHON_BIN" && "${QRL_CHECK_NO_SYNC:-0}" != "1" ]]; then
    "$UV_BIN" sync --extra dev
  fi
}
sync_docs() {
  if [[ -z "$PYTHON_BIN" && "${QRL_CHECK_NO_SYNC:-0}" != "1" ]]; then
    "$UV_BIN" sync --extra dev --extra docs
  fi
}
sync_mutation() {
  if [[ -z "$PYTHON_BIN" && "${QRL_CHECK_NO_SYNC:-0}" != "1" ]]; then
    "$UV_BIN" sync --extra dev --extra mutation
  elif [[ -n "$PYTHON_BIN" && ! -x "$(dirname "$PYTHON_BIN")/mutmut" ]]; then
    if [[ "${QRL_CHECK_NO_SYNC:-0}" == "1" ]]; then
      echo "mutmut is missing from the selected Python environment; install with uv sync --extra dev --extra mutation" >&2
      return 1
    fi
    UV_PROJECT_ENVIRONMENT="$(dirname "$(dirname "$PYTHON_BIN")")" \
      "$UV_BIN" sync --extra dev --extra mutation
  fi
}

run_deps() {
  if [[ -n "$PYTHON_BIN" ]]; then
    UV="$UV_BIN" UV_PYTHON="$PYTHON_BIN" UV_PROJECT_ENVIRONMENT="$(dirname "$(dirname "$PYTHON_BIN")")" make deps-check
  else
    UV="$UV_BIN" make deps-check
  fi
}
run_security_deps() {
  if [[ -n "$PYTHON_BIN" ]]; then
    "$PYTHON_BIN" scripts/dev/security/dependency_audit.py
  else
    python3 scripts/dev/security/dependency_audit.py
  fi
}
run_security_secrets() {
  if [[ -n "$PYTHON_BIN" ]]; then
    "$PYTHON_BIN" scripts/dev/security/secret_scan.py
  else
    python3 scripts/dev/security/secret_scan.py
  fi
}
run_quality() {
  sync_dev
  run_module ruff format --check .
  run_module ruff check .
  run_module mypy .
}
run_architecture() { sync_dev; run_module pytest -q tests/architecture; }
run_docs() {
  sync_docs
  run_module pytest -q tests/architecture/test_documentation_contracts.py
  run_module tools.documentation.check_docs
  run_module tools.documentation.public_api --check
  run_module tools.documentation.configuration_reference --check
  run_module tools.documentation.package_dependency_model --check
  run_module experiments.variants.catalog --check
  run_module sphinx -W --keep-going -b html docs docs/_build/html
}
run_graph_quality() {
  sync_dev
  run_module pytest -q tests/unit/tooling/test_code_graph_quality.py
  local graph_index path status
  graph_index="$(mktemp "${TMPDIR:-/tmp}/qrl-graph-index.XXXXXX")"
  rm -f -- "$graph_index"
  GIT_INDEX_FILE="$graph_index" git read-tree HEAD

  # The architecture refactor is often checked before its new modules are
  # staged. Build the graph from the live source tree while keeping the user's
  # real index untouched: remove deleted paths and intent-to-add new Python or
  # shell sources only in this disposable index.
  while IFS= read -r -d '' path; do
    if [[ ! -e "$path" && ! -L "$path" ]]; then
      GIT_INDEX_FILE="$graph_index" git update-index --force-remove -- "$path"
    fi
  done < <(GIT_INDEX_FILE="$graph_index" git ls-files -z)
  while IFS= read -r -d '' path; do
    case "$path" in
      *.py|*.sh) GIT_INDEX_FILE="$graph_index" git add --intent-to-add -- "$path" ;;
    esac
  done < <(GIT_INDEX_FILE="$graph_index" git ls-files --others --exclude-standard -z)

  if GIT_INDEX_FILE="$graph_index" ./tools/crgraph build; then
    :
  else
    status=$?
    rm -f -- "$graph_index"
    return "$status"
  fi
  if GIT_INDEX_FILE="$graph_index" ./tools/crgraph verify-critical \
    --min-resolution 0.80 --min-critical-resolution 0.70; then
    :
  else
    status=$?
    rm -f -- "$graph_index"
    return "$status"
  fi
  rm -f -- "$graph_index"
}
run_contracts() {
  sync_dev
  run_module pytest -q \
    tests/unit/configuration/test_config_typo_safety.py \
    tests/integration/test_action_schema_contract.py \
    tests/unit/experiments/test_experiment_run_artifacts.py \
    tests/unit/features/test_cache_hash_full_column.py \
    tests/unit/features/test_feature_cache_and_fit_scope.py
}
run_pytest_gate() {
  local marker_expression="$1"
  shift
  if [[ -n "${QRL_COVERAGE_FILE:-}" ]]; then
    local COVERAGE_FILE="$QRL_COVERAGE_FILE"
    export COVERAGE_FILE
    mkdir -p "$(dirname "$QRL_COVERAGE_FILE")"
    run_module pytest -q -m "$marker_expression" \
      --cov --cov-context=test --cov-report= "$@"
  else
    run_module pytest -q -m "$marker_expression" "$@"
  fi
}
run_unit() {
  sync_dev
  run_pytest_gate "unit and not slow and not integration and not architecture and not gpu and not triton and not research" tests
}
run_build() {
  sync_dev
  local build_dir build_status
  build_dir="$(mktemp -d "${TMPDIR:-/tmp}/qrl-build.XXXXXX")"
  if [[ -n "$PYTHON_BIN" ]]; then
    if "$PYTHON_BIN" -m build --outdir "$build_dir"; then
      build_status=0
    else
      build_status=$?
    fi
  else
    if "$UV_BIN" build --out-dir "$build_dir"; then
      build_status=0
    else
      build_status=$?
    fi
  fi
  if [[ "$build_status" -ne 0 ]]; then
    rm -rf -- "$build_dir"
    return "$build_status"
  fi
  smoke='import importlib; [importlib.import_module(name) for name in ("configuration","artifacts","market_data","features","trading","simulation","models","learning","learning.supervised","decisioning","training","evaluation","experiments","live","integrations","compute","orchestra","market_data.cli","training.cli","evaluation.cli","experiments.cli","compute.cli")]; print("build-import-smoke-ok")'
  if [[ -n "$PYTHON_BIN" ]]; then
    if "$PYTHON_BIN" -c "$smoke"; then
      build_status=0
    else
      build_status=$?
    fi
  else
    if "$UV_BIN" run python -c "$smoke"; then
      build_status=0
    else
      build_status=$?
    fi
  fi
  rm -rf -- "$build_dir"
  return "$build_status"
}
run_integration() { sync_dev; run_pytest_gate "integration and not slow" tests; }
run_coverage_report() {
  sync_dev
  local data_dir="${QRL_COVERAGE_DATA_DIR:-.}"
  run_module coverage combine --keep "$data_dir"
  run_module coverage report -m
  run_module coverage json -o coverage.json
  run_module coverage xml -o coverage.xml
  run_module tools.quality.coverage_report --coverage-json coverage.json
}
run_coverage() {
  QRL_COVERAGE_FILE=.coverage.unit run_unit
  QRL_COVERAGE_FILE=.coverage.integration run_integration
  QRL_COVERAGE_DATA_DIR=. run_coverage_report
}
run_research() { sync_dev; run_module pytest -q -m "research and not slow" tests; }
run_test_overlap() { sync_dev; run_module tools.quality.test_overlap "$@"; }
run_mutation_critical() {
  local mutation_children="${QRL_MUTATION_MAX_CHILDREN:-4}"
  if [[ ! "$mutation_children" =~ ^[1-9][0-9]*$ ]]; then
    echo "QRL_MUTATION_MAX_CHILDREN must be a positive integer" >&2
    return 2
  fi
  sync_mutation
  if [[ -n "$PYTHON_BIN" ]]; then
    "$(dirname "$PYTHON_BIN")/mutmut" run --max-children "$mutation_children"
  else
    "$UV_BIN" run --extra dev --extra mutation mutmut run --max-children "$mutation_children"
  fi
}
run_slow() { sync_dev; run_module pytest -q -m slow tests; }
run_parity() {
  sync_dev
  run_module pytest -q \
    tests/integration/backtest/test_broker_fill_accounting.py \
    tests/integration/backtest/test_broker_quote_parity.py \
    tests/integration/backtest/test_engine_execution_contract.py \
    tests/integration/backtest/test_target_reference_contract.py \
    tests/unit/simulation/test_environment/test_bundle_env_equivalence.py \
    tests/unit/simulation/test_environment/test_trading_env_golden_traces.py \
    tests/unit/simulation/test_environment/test_tick_fill_reconciliation.py
}
run_training_smoke() {
  sync_dev
  run_module pytest -q tests/unit/training/test_training_smoke.py tests/unit/training/test_sac_smoke.py
}
run_gpu() {
  if [[ -x scripts/compute/slurm/run_current_tree_gpu_ci.sh ]]; then
    exec scripts/compute/slurm/run_current_tree_gpu_ci.sh
  else
    echo "No Triton GPU gate wrapper found" >&2
    exit 2
  fi
}

case "$GATE" in
  deps) run_deps ;;
  security-deps) run_security_deps ;;
  security-secrets) run_security_secrets ;;
  quality) run_quality ;;
  architecture) run_architecture ;;
  docs) run_docs ;;
  coverage) run_coverage ;;
  coverage-report) run_coverage_report ;;
  graph-quality) run_graph_quality ;;
  contracts) run_contracts ;;
  unit) run_unit ;;
  build) run_build ;;
  integration) run_integration ;;
  research) run_research ;;
  test-overlap) shift; run_test_overlap "$@" ;;
  mutation-critical) run_mutation_critical ;;
  slow) run_slow ;;
  parity) run_parity ;;
  training-smoke) run_training_smoke ;;
  fast) run_deps; run_architecture; run_contracts ;;
  full)
    run_deps
    run_security_deps
    run_security_secrets
    run_quality
    run_architecture
    run_docs
    run_graph_quality
    run_contracts
    QRL_COVERAGE_FILE=.coverage.full.unit run_unit
    run_build
    QRL_COVERAGE_FILE=.coverage.full.integration run_integration
    run_coverage_report
    run_parity
    run_training_smoke
    ;;
  gpu|triton) run_gpu ;;
  *) echo "usage: $0 {deps|security-deps|security-secrets|quality|architecture|docs|coverage|coverage-report|graph-quality|contracts|unit|build|integration|research|slow|parity|training-smoke|fast|full|gpu|triton}" >&2; exit 2 ;;
esac
