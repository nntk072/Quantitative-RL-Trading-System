#!/usr/bin/env python3
"""Show repository revision and staleness of one shared agent context packet."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path


def git(repo: Path, *args: str) -> str:
    return subprocess.run(
        ["git", "-C", str(repo), *args], check=True, capture_output=True, text=True
    ).stdout.rstrip("\n")


def stale_fact(repo: Path, revision: str, source: str, dirty: set[str]) -> bool:
    path = source.split("::", 1)[0].split(":", 1)[0]
    if not path or path in dirty:
        return True
    try:
        return bool(git(repo, "diff", "--name-only", f"{revision}..HEAD", "--", path))
    except subprocess.CalledProcessError:
        return True


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--task", type=Path, help="task context directory containing facts.jsonl")
    args = parser.parse_args()
    try:
        repo = Path(git(args.repo.resolve(), "rev-parse", "--show-toplevel"))
        revision = git(repo, "rev-parse", "HEAD")
        status = git(repo, "status", "--porcelain=v1", "-z").split("\0")
        dirty: set[str] = set()
        index = 0
        while index < len(status):
            entry = status[index]
            if not entry:
                index += 1
                continue
            dirty.add(entry[3:])
            if entry[:2].strip() in {"R", "C"}:
                index += 1
            index += 1
    except (OSError, subprocess.CalledProcessError) as exc:
        print(f"cannot inspect repository: {exc}", file=sys.stderr)
        return 2
    print(f"HEAD {revision}")
    print(f"dirty paths {len(dirty)}")
    task = args.task.resolve() if args.task else None
    if task is None:
        print("shared context: not requested")
        return 0
    print(f"shared context {task}")
    facts = task / "facts.jsonl"
    ownership = task / "ownership.json"
    if ownership.is_file():
        try:
            print(
                f"active ownership {json.dumps(json.loads(ownership.read_text(encoding='utf-8')), sort_keys=True)}"
            )
        except (json.JSONDecodeError, OSError) as exc:
            print(f"invalid ownership file: {exc}", file=sys.stderr)
            return 2
    if not facts.is_file():
        print(f"shared context: no facts file at {facts}")
        return 0
    count = 0
    stale = 0
    for line_number, line in enumerate(facts.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            fact = json.loads(line)
            count += 1
            if stale_fact(repo, fact["revision"], fact["source"], dirty):
                stale += 1
                print(f"stale fact line {line_number}: {fact.get('source', '<unknown source>')}")
        except (json.JSONDecodeError, KeyError, TypeError) as exc:
            print(f"invalid fact line {line_number}: {exc}", file=sys.stderr)
            return 2
    print(f"shared facts {count}; stale {stale}")
    return 1 if stale else 0


if __name__ == "__main__":
    raise SystemExit(main())
