{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "type": "object"
    },
    "claim": {
      "additionalProperties": false,
      "properties": {
        "allowed_interpretation": {
          "minLength": 1,
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "type": "string"
        },
        "comparison_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence_role": {
          "enum": [
            "screening",
            "matched_confirmation",
            "robustness",
            "cost_stress",
            "descriptive",
            "runtime",
            "correctness"
          ]
        },
        "forbidden_overclaims": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rq": {
          "minLength": 1,
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "thesis_destination": {
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "rq",
        "statement",
        "evidence_role",
        "allowed_interpretation",
        "limitations",
        "comparison_ids"
      ],
      "type": "object"
    },
    "comparison": {
      "additionalProperties": false,
      "properties": {
        "comparability_audit": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "comparison_id": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_role": {
          "enum": [
            "screening",
            "matched_confirmation",
            "robustness",
            "cost_stress",
            "descriptive",
            "runtime",
            "correctness"
          ]
        },
        "figures_and_tables": {
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "type": "array"
        },
        "question": {
          "minLength": 1,
          "type": "string"
        },
        "run_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "statistics": {
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "complete",
            "failed",
            "excluded"
          ]
        }
      },
      "required": [
        "comparison_id",
        "question",
        "run_ids",
        "evidence_role",
        "status",
        "limitations"
      ],
      "type": "object"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "cache_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "checkpoint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "data_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "git_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "source_hash_manifest_path": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "source_hash_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "git_sha",
        "source_hash_manifest_sha256",
        "config_sha256"
      ],
      "type": "object"
    },
    "reviewDisposition": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "open_findings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reviewed_at_utc": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "blocking_findings",
            "resolved",
            "resolved_with_disclosures"
          ]
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_at_utc",
        "artifact"
      ],
      "type": "object"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "type": "array"
        },
        "completed_timesteps": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "data_calendar_role": {
          "type": "string"
        },
        "experiment_run_id": {
          "minLength": 1,
          "type": "string"
        },
        "failure_disposition": {
          "type": [
            "string",
            "null"
          ]
        },
        "full_split_exposure": {
          "enum": [
            "verified",
            "failed",
            "not_verified",
            "not_applicable"
          ]
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "interpretation_limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "n_envs": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "requested_timesteps": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "role": {
          "enum": [
            "smoke",
            "development",
            "selection",
            "robustness",
            "final_report_only",
            "runtime_benchmark",
            "correctness",
            "other"
          ]
        },
        "run_id": {
          "minLength": 1,
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "planned",
            "running",
            "succeeded",
            "failed",
            "interrupted",
            "inactive",
            "excluded"
          ]
        },
        "variant": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "experiment_run_id",
        "variant",
        "seed",
        "role",
        "status",
        "identity",
        "artifacts"
      ],
      "type": "object"
    }
  },
  "$id": "https://aalto.example/schemas/thesis-result-manifest-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Claim-to-run-to-artifact map. A valid schema instance is not scientific validation or readiness evidence.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/claim"
      },
      "type": "array"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/comparison"
      },
      "type": "array"
    },
    "created_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "frozen_at_utc": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "manifest_status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "protocol_path": {
      "minLength": 1,
      "type": "string"
    },
    "review_disposition": {
      "$ref": "#/$defs/reviewDisposition"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/run"
      },
      "type": "array"
    },
    "schema": {
      "const": "aalto.thesis_result_manifest.v1"
    },
    "supporting_artifacts": {
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "manifest_status",
    "created_at_utc",
    "claims",
    "comparisons",
    "runs",
    "supporting_artifacts"
  ],
  "title": "Aalto thesis result manifest",
  "type": "object"
}
